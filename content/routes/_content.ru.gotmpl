{{ range site.Data.routes }}
    {{ $content := dict
        "mediaType" "text/markdown"
        "value" (printf "{{< single-route \"%v\" \"%v\" \"%v\" >}}" .online_tickets_current_site .online_tickets_new_site "ru")
    }}
    {{ $params := dict 
        "id" .id
        "ref" .ref
        "stations" .stations
        "active" .active
        "frequency" .frequency
        "start_date" .start_date
        "end_date" .end_date
        "complete" .complete
        "online" .online
        "travel_time" .travel_time
        "price" .price
        "train_type" .train_type
        "analogue" .analogue
        "reverse" .reverse
        "has_arrival_time" .has_arrival_time
        "description_ru" .description_ru
        "extended_description_ru" .extended_description_ru
    }}
    {{ $name := index . "name:ru" }}
    {{- /* Share-preview image (scripts/make_share_images.py), only if it was built */}}
    {{ $image := printf "/images/share/routes/%v.png" .ref }}
    {{ if fileExists (path.Join "static" $image) }}
        {{ $params = merge $params (dict "images" (slice $image)) }}
    {{ end }}
    {{- /* No route number or direction: the title next to it in previews already has them.
         Inactive covers both cancelled and seasonal (off-season) trains. */}}
    {{ $description := "Расписание, цены на билеты, все остановки на карте и как купить билет." }}
    {{ if not .active }}{{ $description = "Сейчас этот поезд не ходит. Подробности — на странице." }}{{ end }}
    {{ $page := dict
        "content" $content
        "description" $description
        "kind" "page"
        "path" .ref
        "title" (printf "Поезд %v: %s" .ref $name)
        "params" $params
        "weight" .ref
    }}
    {{ $.AddPage $page }}
{{ end }}
